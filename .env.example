# Root env example (copy to .env if needed for environment overrides)
# Backend
BACKEND_PORT=5000
# Frontend  
FRONTEND_PORT=3000

# ====== Security & Modes ======
FLASK_ENV=development
ENV=development
DEMO_MODE=false

# ====== Backend CORS ======
ALLOWED_ORIGINS=http://localhost:5173

# ====== Auth ======
SECRET_KEY=change-me
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# ====== External APIs ======
ALPHA_VANTAGE_KEY=
EXCHANGERATE_API_KEY=
ELEVENLABS_API_KEY=
STRIPE_SECRET_KEY=