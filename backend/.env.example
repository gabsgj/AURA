# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
DATABASE_URL=sqlite:///aura.db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_PER_MINUTE=50 per minute

# Logging
LOG_LEVEL=INFO

# External API Keys (Required for full functionality)
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
ELEVENLABS_API_KEY=your-elevenlabs-key
GEMINI_API_KEY=your-gemini-key
STRIPE_SECRET_KEY=your-stripe-secret-key
WISE_API_KEY=your-wise-api-key
EXCHANGERATE_API_KEY=your-exchangerate-api-key

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Demo Mode (for testing)
DEMO_MODE=true

# Environment
ENV=development

# FX
FX_API_BASE=https://api.exchangerate.host

# Payments
STRIPE_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Server
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false

# ML Models & Fraud Detection

# Wise API Key for payment routing (sandbox/production)
WISE_API_KEY=your_wise_api_key_here
WISE_ENVIRONMENT=sandbox

# Remitly API credentials (if available)
REMITLY_API_KEY=your_remitly_api_key_here

# Western Union API credentials (if available)
WU_API_KEY=your_western_union_api_key_here

# ===== Database & Authentication =====

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Database URL (use Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_here

# ===== Security =====

# Fernet encryption key for sensitive data
FERNET_KEY=your_fernet_key_here

# CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate limiting (requests per minute)
RATE_LIMIT_DEFAULT=200
RATE_LIMIT_WINDOW=1 minute

# ===== Server Configuration =====

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=false

# Server settings
HOST=0.0.0.0
PORT=5000

# ===== ML Models & Fraud Detection =====

# Enable advanced fraud detection
ENABLE_FRAUD_DETECTION=true

# Model confidence thresholds
FRAUD_DETECTION_THRESHOLD=0.7
FX_PREDICTION_CONFIDENCE=0.8

# ===== Logging =====

LOG_LEVEL=INFO
LOG_FILE=logs/aura.log

# ===== Feature Flags =====

FEATURE_AI_ROUTING=true
FEATURE_FX_PREDICTION=true
FEATURE_FRAUD_DETECTION=true
FEATURE_MULTILINGUAL=true
