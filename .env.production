# AURA Production Environment Configuration
# Copy this file to .env and fill in your actual API keys

# ===== Core Flask Configuration =====
SECRET_KEY=your-secret-key-change-in-production
DATABASE_URL=postgresql://username:password@localhost/aura_db
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ===== AI & Voice Services =====

# Google Gemini API Key for natural language processing
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key for text-to-speech (REQUIRED)
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MODEL=eleven_multilingual_v2

# ===== Payment Provider APIs =====

# Wise API for real payment routing (Sandbox/Production)
# Get from: https://api-docs.wise.com/
WISE_API_KEY=your_wise_api_key_here
WISE_ENVIRONMENT=sandbox

# Remitly API (if available)
REMITLY_API_KEY=your_remitly_api_key_here

# Western Union API (if available)
WU_API_KEY=your_western_union_api_key_here

# ===== FX Rate APIs =====

# Alpha Vantage for FX rate prediction and historical data
# Get from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ExchangeRate-API for real-time rates
# Get from: https://app.exchangerate-api.com/
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# FX API Base URL
FX_API_BASE=https://api.exchangerate.host

# ===== Database & Authentication =====

# Supabase Configuration (Optional - for cloud database)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_here

# ===== Payment Processing =====

# Stripe API Key for payment processing
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here

# ===== Security =====

# Fernet encryption key for sensitive data
FERNET_KEY=your_fernet_key_here

# Rate limiting (requests per minute)
RATE_LIMIT_DEFAULT=200
RATE_LIMIT_WINDOW=1 minute

# ===== Server Configuration =====

# Flask environment
FLASK_ENV=production
FLASK_DEBUG=false

# Server settings
HOST=0.0.0.0
PORT=5000

# ===== Feature Flags =====

# Enable/disable AI features
FEATURE_AI_ROUTING=true
FEATURE_FX_PREDICTION=true
FEATURE_FRAUD_DETECTION=true
FEATURE_MULTILINGUAL=true

# ===== Logging =====

LOG_LEVEL=INFO
LOG_FILE=logs/aura.log

# ===== ML Models =====

# Model confidence thresholds
FRAUD_DETECTION_THRESHOLD=0.7
FX_PREDICTION_CONFIDENCE=0.8